---
import { getCollection } from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/static/NavBar.astro";
import HeroSection from "../components/static/HeroSection.astro";
import Section from "../components/static/Section.astro";
import SectionHeader from "../components/static/SectionHeader.astro";
import ContactSection from "../components/static/ContactSection.astro";
import Footer from "../components/static/Footer.astro";
import BackToTop from "../components/static/BackToTop.astro";
import MobileDock from "../components/islands/MobileDock";
import TechStackSection from "../components/islands/TechStackSection";
import ProjectShowcase from "../components/islands/ProjectShowcase";
import type { Project } from "../types";

const entries = await getCollection("projects");
const projects: Project[] = entries.map((entry) => ({
  id: entry.id,
  ...entry.data,
  platform: entry.data.platform ?? "mobile",
}));
---

<BaseLayout>
  <NavBar />
  <MobileDock client:load />
  <BackToTop />

  <main>
    <HeroSection />

    <Section id="projects">
      <div class="mx-auto max-w-5xl px-6">
        <SectionHeader
          eyebrow="Portfolio"
          title="Projects"
          description="Karya-karya Android yang pernah saya bangun."
        />
        <ProjectShowcase projects={projects} client:visible />
      </div>
    </Section>

    <Section id="skills">
      <div class="mx-auto max-w-5xl px-6">
        <SectionHeader
          eyebrow="Tech stack"
          title="Skills"
          description="Tool dan teknologi yang saya pakai sehari-hari."
        />
        <div class="flex justify-center">
          <TechStackSection client:visible />
        </div>
      </div>
    </Section>

    <Section id="contact" class="py-0">
      <ContactSection />
    </Section>
  </main>

  <Footer />
</BaseLayout>
