---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <main class="flex min-h-screen flex-col items-center justify-center px-6 text-center">
    <p class="font-mono text-sm uppercase tracking-[0.2em] text-silver">Error 404</p>
    <h1 class="mt-4 font-fraunces text-5xl font-bold text-foreground sm:text-6xl">
      Halaman tidak ditemukan
    </h1>
    <p class="mt-4 max-w-md text-silver">
      Halaman yang Anda cari tidak ada. Mungkin tautannya salah atau sudah dipindah.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex min-h-11 items-center rounded-full border border-silver/20 px-6 py-3 text-sm font-semibold text-foreground transition-colors hover:bg-silver/10"
    >
      Kembali ke beranda
    </a>
  </main>
</BaseLayout>
