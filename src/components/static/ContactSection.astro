---
import { socialLinks } from "../../data/social";
---

<section id="contact" class="mx-auto max-w-5xl scroll-mt-24 px-6">
  <p class="font-mono text-sm uppercase tracking-[0.2em] text-silver">Contact</p>
  <h2 class="mt-2 font-fraunces text-3xl font-bold text-foreground sm:text-4xl">
    Mari terhubung
  </h2>
  <p class="mt-3 max-w-2xl text-silver">
    Tertarik berkolaborasi atau sekadar ingin berbicara tentang Android development?
  </p>
  <ul class="mt-8 flex flex-wrap gap-4">
    {
      socialLinks.map((link) => (
        <li>
          <a
            href={link.href}
            target={link.icon === "email" ? undefined : "_blank"}
            rel={link.icon === "email" ? undefined : "noopener noreferrer"}
            class="inline-flex min-h-11 items-center gap-2 rounded-lg bg-white px-5 py-3 text-sm font-medium text-[#0a0a0a] shadow-sm transition-transform hover:-translate-y-0.5"
          >
            {link.icon === "github" && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .5C5.73.5.5 5.73.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2.2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.81 1.18 1.84 1.18 3.1 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.05.78 2.12v3.14c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z" />
              </svg>
            )}
            {link.icon === "linkedin" && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.45 2H3.55C2.69 2 2 2.69 2 3.55v16.9c0 .86.69 1.55 1.55 1.55h16.9c.86 0 1.55-.69 1.55-1.55V3.55c0-.86-.69-1.55-1.55-1.55ZM8 18.5H5V9.5h3v9ZM6.5 8.2a1.74 1.74 0 1 1 0-3.48 1.74 1.74 0 0 1 0 3.48ZM18.5 18.5h-3V14c0-1.07-.02-2.45-1.5-2.45-1.5 0-1.73 1.17-1.73 2.37v4.58H9.3V9.5h2.88v1.23h.04c.4-.76 1.38-1.55 2.84-1.55 3.04 0 3.6 2 3.6 4.6v4.72Z" />
              </svg>
            )}
            {link.icon === "email" && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="4" width="20" height="16" rx="2" />
                <path d="m2 7 10 6 10-6" />
              </svg>
            )}
            {link.icon === "github" ? "github" : link.label}
          </a>
        </li>
      ))
    }
  </ul>
</section>
