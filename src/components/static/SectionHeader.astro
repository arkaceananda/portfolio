---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="mb-10">
  <p class="font-mono text-sm uppercase tracking-[0.2em] text-silver">{eyebrow}</p>
  <h2 class="mt-2 font-fraunces text-3xl font-bold text-foreground sm:text-4xl">
    {title}
  </h2>
  {description && <p class="mt-3 max-w-2xl text-silver">{description}</p>}
</header>
