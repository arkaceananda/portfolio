---
import ThemeToggle from "../islands/ThemeToggle";
import { navItems } from "../../data/navigation";
---

<header class="fixed inset-x-0 top-0 z-40 hidden border-b border-silver/10 bg-background/80 backdrop-blur-sm sm:block">
  <nav
    aria-label="Navigasi desktop"
    class="mx-auto flex h-16 max-w-5xl items-center justify-between px-6"
  >
    <a href="#top" class="font-fraunces text-lg font-semibold text-foreground">
      Arka Aceananda
    </a>
    <ul class="flex items-center gap-8">
      {
        navItems.filter((item) => item.href !== "#top").map((item) => (
          <li>
            <a
              href={item.href}
              class="text-sm text-silver transition-colors hover:text-foreground"
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li><ThemeToggle client:idle /></li>
    </ul>
  </nav>
</header>
