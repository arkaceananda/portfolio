---
import "@fontsource/fraunces";
import "@fontsource/inter";
import "@fontsource/dm-mono";
import "../styles/global.css";
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <script is:inline>
      (function () {
        let saved = null;
        try {
          saved = localStorage.getItem("theme");
        } catch {}
        const theme = saved === "light" || saved === "dark" ? saved : "dark";
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title>Arka Aceananda - Android Developer</title>
    <meta
      name="description"
      content="Portfolio Arka Aceananda, Android Developer. Kotlin, Jetpack Compose."
    />
    <meta name="author" content="Arka Aceananda" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Arka Aceananda" />
    <meta property="og:title" content="Arka Aceananda - Android Developer" />
    <meta
      property="og:description"
      content="Portfolio Arka Aceananda, Android Developer. Kotlin, Jetpack Compose."
    />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:image" content={new URL("/og-image.png", Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Arka Aceananda - Android Developer" />
    <meta
      name="twitter:description"
      content="Portfolio Arka Aceananda, Android Developer. Kotlin, Jetpack Compose."
    />
    <meta name="twitter:image" content={new URL("/og-image.png", Astro.site).href} />
  </head>
  <body>
    <slot />
  </body>
</html>
